# =============================================================================
# Multi-Database — Environment Variables
# =============================================================================
# ⚠  NEVER commit this file to version control.
#    Copy .env.example to .env and fill in your own values.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Seeds chinook, sakila, northwind, world and menagerie on first start
MYSQL_ROOT_PASSWORD=mysql123
MYSQL_PORT=3306

# ── SQL Server ────────────────────────────────────────────────────────────────
# Password must meet SQL Server complexity requirements:
#   8+ chars, uppercase, lowercase, digit, special char
MSSQL_PASSWORD=SqlServer123!
MSSQL_PORT=1433

# ── Oracle XE ─────────────────────────────────────────────────────────────────
# This becomes the password for SYS, SYSTEM, CHINOOK, HR, CO and SH users
ORACLE_PASSWORD=Oracle123!
ORACLE_PORT=1521

# SH (Sales History) is ~1 M rows across partitioned + bitmap-indexed tables
# and is the slowest part of a first start (10–20 min). Set to true to skip it;
# CHINOOK, HR and CO are unaffected either way.
ORACLE_SKIP_SH=false

# ── SQLite / Datasette ────────────────────────────────────────────────────────
SQLITE_PORT=8001
