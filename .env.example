# =============================================================================
# Multi-Database — Environment Variables (template)
# =============================================================================
# Copy to .env and fill in your own values.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3306

# ── SQL Server ────────────────────────────────────────────────────────────────
# Password must meet SQL Server complexity requirements:
#   8+ chars, uppercase, lowercase, digit, special char
MSSQL_PASSWORD=Change_me_1
MSSQL_PORT=1433

# ── Oracle XE ─────────────────────────────────────────────────────────────────
ORACLE_PASSWORD=Change_me_1
ORACLE_PORT=1521

# Set to true to skip the SH (Sales History) schema — the slowest part of a first start.
ORACLE_SKIP_SH=false

# ── SQLite / Datasette ────────────────────────────────────────────────────────
SQLITE_PORT=8001
